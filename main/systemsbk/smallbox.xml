<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <include>./animatedbackgroundsubset.xml</include>
  <view name="system">
    <image name="randomImage" extra="true">
      <default>./main/media/nocover.png</default>
      <path>{random:thumbnail}</path>
      <color>FFFFFF</color>
      <origin>0 0</origin>
      <pos>0.685 0.595</pos>
      <maxSize>0.3 0.3</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>150</zIndex>
    </image>
    <image name="ControllerOverlay" extra="true">
      <visible>false</visible>
    </image>
    <image name="CenterFade" extra="true">
      <color>000000A0</color>
    </image>
  </view>
</theme>
